# Copy to .env.local for local development. Never commit .env.local.
# Production values live in Vercel → Project → Settings → Environment Variables.
# Validated by src/lib/env.ts: a production build fails when a required value is
# missing or malformed. Add new variables to the schema there and to this file.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; used by API routes, crons and server components.
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login/proprietario
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup/proprietario
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Scheduled jobs (Vercel sends Authorization: Bearer <CRON_SECRET>) ─────
# Required: the cron routes fail closed without it.
CRON_SECRET=

# ── IoT gateway ingest (shared with apps/edge-gateway) ────────────────────
GATEWAY_INGEST_KEY=

# ── AI extraction (bills, contracts, identity documents) ──────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: override the model names in src/lib/ai-models.ts without a code change.
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o
# OPENAI_MINI_MODEL=gpt-4o-mini

# ── Optional integrations ─────────────────────────────────────────────────
# CPF enrichment (BigDataCorp). Leave empty to disable.
BIGDATACORP_TOKEN=

# ── Google Maps (the dashboard map) ───────────────────────────────────────
# Browser key: Maps JavaScript API only, restricted to the site's HTTP referrers. Empty = no map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID from the Cloud console (advanced markers). Empty = Google's demo map id.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server key: Geocoding API, restricted by IP/API, never sent to the browser. Empty = BrasilAPI CEP coordinates.
GOOGLE_MAPS_SERVER_KEY=

# ── Fatura (tenant invoicing) ─────────────────────────────────────────────
# Seals each owner's bank credentials before they are stored. 32 random bytes: `openssl rand -base64 32`.
# Empty = nothing can be connected (the screen says so). Keep it safe: without it the stored credentials cannot be read.
BILLING_ENCRYPTION_KEY=
# Only while rotating the key above: the old key, so what it sealed still opens.
BILLING_ENCRYPTION_KEY_PREVIOUS=
# Invoices e-mailed to tenants through Resend (https://resend.com): the API key and the sender, on a domain verified there.
# Both or neither. Empty = nothing is sent; each delivery says so in Faturas.
RESEND_API_KEY=
BILLING_EMAIL_FROM="Kitnets <faturas@kitnets.com>"
# Optional: the signing secret of the Resend webhook (Webhooks → Add endpoint → https://<site>/api/webhooks/resend,
# events email.delivered, email.bounced, email.complained). Without it the invoices say "Enviado", never "Entregue".
RESEND_WEBHOOK_SECRET=
# The Kitnets Stripe PLATFORM account (not an owner's): secret key, Connect client id (Settings → Connect →
# Onboarding options → OAuth) and the signing secret of the Connect webhook endpoint (/api/webhooks/stripe,
# "listen to events on connected accounts"). All three or none. Test keys = sandbox, no real money.
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# ── Dashboard ─────────────────────────────────────────────────────────────
# Accounts that see the IoT gateways block (a founder-only pilot), comma-separated. Empty = the founder's e-mail.
GATEWAY_PILOT_EMAILS=

# ── Error tracking (Sentry). All optional; empty DSN = disabled. ──────────
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time (Vercel):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
