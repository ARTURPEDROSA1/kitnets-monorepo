{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "**/.env.*local"
    ],
    "globalEnv": [
        "SUPABASE_SERVICE_ROLE_KEY",
        "GATEWAY_INGEST_KEY",
        "CLERK_SECRET_KEY",
        "CRON_SECRET",
        "OPENAI_API_KEY",
        "GEMINI_API_KEY",
        "BIGDATACORP_TOKEN",
        "GOOGLE_MAPS_SERVER_KEY",
        "GATEWAY_PILOT_EMAILS",
        "BILLING_ENCRYPTION_KEY",
        "BILLING_ENCRYPTION_KEY_PREVIOUS",
        "RESEND_API_KEY",
        "BILLING_EMAIL_FROM",
        "RESEND_WEBHOOK_SECRET",
        "STRIPE_SECRET_KEY",
        "STRIPE_CLIENT_ID",
        "STRIPE_WEBHOOK_SECRET"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**"
            ]
        },
        "lint": {},
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
